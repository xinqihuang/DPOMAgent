{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://dpom/contracts/diagnostic-report/v1/diagnostic-report.schema.json",
  "title":"Diagnostic Report v1","type":"object","additionalProperties":false,
  "required":["contractType","schemaVersion","reportProfile","reportId","revision","identity","target","incidentWindow","timeline","observations","hypotheses","conclusions","evidenceReferences","gapCodes","recommendations","evaluation","provenance","generatedAt","completeness","extensions","reportDigest"],
  "properties":{
    "contractType":{"const":"diagnostic-report"},"schemaVersion":{"const":"1.0.0"},
    "reportProfile":{"enum":["DIAGNOSIS_ONLY","DIAGNOSIS_EVALUATED"]},
    "reportId":{"$ref":"#/$defs/id"},"revision":{"type":"integer","minimum":1,"maximum":1000000},
    "supersedesReportId":{"anyOf":[{"$ref":"#/$defs/id"},{"type":"null"}]},
    "changeReasons":{"type":"array","maxItems":8,"uniqueItems":true,"items":{"$ref":"#/$defs/code"}},
    "identity":{"type":"object","additionalProperties":false,"required":["incidentId","investigationId","runId"],"properties":{"incidentId":{"$ref":"#/$defs/id"},"investigationId":{"$ref":"#/$defs/id"},"runId":{"$ref":"#/$defs/id"}}},
    "target":{"type":"object","additionalProperties":false,"required":["provider","region","resourceType","resourceId","displayName"],"properties":{"provider":{"$ref":"#/$defs/code"},"region":{"$ref":"#/$defs/id"},"resourceType":{"$ref":"#/$defs/code"},"resourceId":{"$ref":"#/$defs/id"},"displayName":{"$ref":"#/$defs/text"}}},
    "incidentWindow":{"$ref":"#/$defs/window"},
    "timeline":{"type":"array","minItems":1,"maxItems":128,"items":{"type":"object","additionalProperties":false,"required":["itemId","at","stateCode","summary"],"properties":{"itemId":{"$ref":"#/$defs/id"},"at":{"$ref":"#/$defs/time"},"stateCode":{"$ref":"#/$defs/code"},"summary":{"$ref":"#/$defs/text"}}}},
    "observations":{"type":"array","minItems":1,"maxItems":128,"items":{"$ref":"#/$defs/claim"}},
    "hypotheses":{"type":"array","maxItems":64,"items":{"$ref":"#/$defs/claim"}},
    "conclusions":{"type":"array","minItems":1,"maxItems":32,"items":{"$ref":"#/$defs/conclusion"}},
    "evidenceReferences":{"type":"array","minItems":1,"maxItems":256,"items":{"$ref":"#/$defs/evidence"}},
    "gapCodes":{"type":"array","maxItems":32,"uniqueItems":true,"items":{"enum":["MISSING_REQUIRED_EVIDENCE","MISSING_REQUIRED_JUDGE","UNAVAILABLE_JUDGE","STALE_SOURCE","INTEGRITY_MISMATCH","UNSUPPORTED_SOURCE_VERSION","MISSING_PROVENANCE","REDACTED_REQUIRED_CONTENT","INCOMPATIBLE_EVALUATION"]}},
    "recommendations":{"type":"array","maxItems":32,"items":{"type":"object","additionalProperties":false,"required":["itemId","summary","supportingEvidenceRefs","safetyCode","executionState"],"properties":{"itemId":{"$ref":"#/$defs/id"},"summary":{"$ref":"#/$defs/text"},"supportingEvidenceRefs":{"$ref":"#/$defs/refs"},"safetyCode":{"$ref":"#/$defs/code"},"executionState":{"const":"ADVISORY_ONLY"}}}},
    "evaluation":{"$ref":"#/$defs/evaluation"},"provenance":{"type":"array","minItems":1,"maxItems":64,"items":{"$ref":"#/$defs/component"}},
    "generatedAt":{"$ref":"#/$defs/time"},"completeness":{"enum":["COMPLETE","INCOMPLETE"]},
    "extensions":{"type":"object","maxProperties":16,"propertyNames":{"pattern":"^provider\\.[a-z0-9-]+\\.[a-z0-9-]+@[1-9][0-9]*$"},"additionalProperties":{"type":"object","maxProperties":32}},
    "reportDigest":{"type":"string","pattern":"^[0-9a-f]{64}$"}
  },
  "$defs":{
    "id":{"type":"string","minLength":1,"maxLength":128,"pattern":"^[A-Za-z0-9][A-Za-z0-9._:/-]*$"},
    "code":{"type":"string","minLength":1,"maxLength":64,"pattern":"^[A-Z][A-Z0-9_./:-]*$"},
    "text":{"type":"string","minLength":1,"maxLength":1024},"time":{"type":"string","format":"date-time","maxLength":35},
    "window":{"type":"object","additionalProperties":false,"required":["from","to"],"properties":{"from":{"$ref":"#/$defs/time"},"to":{"$ref":"#/$defs/time"}}},
    "refs":{"type":"array","maxItems":64,"uniqueItems":true,"items":{"$ref":"#/$defs/id"}},
    "claim":{"type":"object","additionalProperties":false,"required":["itemId","claimType","summary","confidenceBasisPoints","supportingEvidenceRefs","contradictingEvidenceRefs"],"properties":{"itemId":{"$ref":"#/$defs/id"},"claimType":{"enum":["OBSERVATION","HYPOTHESIS"]},"summary":{"$ref":"#/$defs/text"},"confidenceBasisPoints":{"type":"integer","minimum":0,"maximum":10000},"supportingEvidenceRefs":{"$ref":"#/$defs/refs"},"contradictingEvidenceRefs":{"$ref":"#/$defs/refs"}}},
    "conclusion":{"type":"object","additionalProperties":false,"required":["itemId","claimType","summary","confidenceBasisPoints","supportingEvidenceRefs","contradictingEvidenceRefs","disposition"],"properties":{"itemId":{"$ref":"#/$defs/id"},"claimType":{"const":"CONCLUSION"},"summary":{"$ref":"#/$defs/text"},"confidenceBasisPoints":{"type":"integer","minimum":0,"maximum":10000},"supportingEvidenceRefs":{"$ref":"#/$defs/refs"},"contradictingEvidenceRefs":{"$ref":"#/$defs/refs"},"disposition":{"enum":["CONFIRMED","HYPOTHESIS","UNDETERMINED"]}}},
    "evidence":{"type":"object","additionalProperties":false,"required":["evidenceId","sourceCapability","sourceAdapter","artifactRef","sha256","collectedAt","window","targetResourceId","sensitivity","redaction"],"properties":{"evidenceId":{"$ref":"#/$defs/id"},"sourceCapability":{"$ref":"#/$defs/code"},"sourceAdapter":{"$ref":"#/$defs/id"},"artifactRef":{"$ref":"#/$defs/id"},"sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"},"collectedAt":{"$ref":"#/$defs/time"},"window":{"$ref":"#/$defs/window"},"targetResourceId":{"$ref":"#/$defs/id"},"sensitivity":{"enum":["PUBLIC","INTERNAL","CONTROLLED"]},"redaction":{"enum":["NONE","REDACTED_POLICY","REDACTED_SECRET"]}}},
    "evaluation":{"type":"object","additionalProperties":false,"required":["outcome","lineage","judges"],"properties":{"outcome":{"enum":["PASS","FAIL","INCOMPLETE","NOT_REQUIRED"]},"lineage":{"type":"object","additionalProperties":false,"properties":{"evalCaseId":{"$ref":"#/$defs/id"},"evalCaseVersion":{"type":"integer","minimum":1},"evalRunId":{"$ref":"#/$defs/id"},"datasetId":{"$ref":"#/$defs/id"},"datasetVersion":{"type":"integer","minimum":1},"datasetMembershipDigest":{"type":"string","pattern":"^[0-9a-f]{64}$"},"replayPlanId":{"$ref":"#/$defs/id"},"replayRunId":{"$ref":"#/$defs/id"},"suiteId":{"$ref":"#/$defs/id"},"suiteVersion":{"$ref":"#/$defs/id"},"diagnosisSourceReportId":{"$ref":"#/$defs/id"},"diagnosisSourceRevision":{"type":"integer","minimum":1},"diagnosisSourceDigest":{"type":"string","pattern":"^[0-9a-f]{64}$"}}},"judges":{"type":"array","maxItems":16,"items":{"type":"object","additionalProperties":false,"required":["judgeResultId","kind","judgeId","judgeVersion","status","inputDigest"],"properties":{"judgeResultId":{"$ref":"#/$defs/id"},"kind":{"enum":["ROOT_CAUSE_CORRECTNESS","EVIDENCE_SUFFICIENCY","TIMELINE_CONSISTENCY","RECOMMENDATION_SAFETY","RULE_INVARIANTS","SCHEMA_INTEGRITY"]},"judgeId":{"$ref":"#/$defs/id"},"judgeVersion":{"$ref":"#/$defs/id"},"status":{"enum":["PASS","FAIL","INCOMPLETE","UNAVAILABLE"]},"inputDigest":{"type":"string","pattern":"^[0-9a-f]{64}$"}}}}}},
    "component":{"type":"object","additionalProperties":false,"required":["componentId","componentVersion","contractVersion","sourceDigest"],"properties":{"componentId":{"$ref":"#/$defs/id"},"componentVersion":{"$ref":"#/$defs/id"},"contractVersion":{"$ref":"#/$defs/id"},"sourceDigest":{"type":"string","pattern":"^[0-9a-f]{64}$"}}}
  }
}
