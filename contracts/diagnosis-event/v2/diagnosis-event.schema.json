{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dpom.internal/contracts/diagnosis-event/v2/diagnosis-event.schema.json",
  "title": "DPOM Diagnosis Event v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "eventId", "eventType", "schemaVersion", "occurredAt", "producer", "sourceAuthority",
    "incidentId", "investigationId", "runId", "aggregateSequence", "idempotencyKey",
    "provenance", "evidenceManifest"
  ],
  "properties": {
    "eventId": { "type": "string", "format": "uuid" },
    "eventType": {
      "type": "string",
      "enum": ["investigation.completed", "investigation.replay-ready"]
    },
    "schemaVersion": { "type": "string", "pattern": "^2\\.[0-9]+$" },
    "occurredAt": { "type": "string", "format": "date-time" },
    "producer": { "$ref": "#/$defs/producer" },
    "sourceAuthority": { "$ref": "#/$defs/sourceAuthority" },
    "incidentId": { "$ref": "#/$defs/domainIdentifier" },
    "investigationId": { "$ref": "#/$defs/domainIdentifier" },
    "runId": { "$ref": "#/$defs/domainIdentifier" },
    "aggregateSequence": { "type": "integer", "minimum": 1 },
    "idempotencyKey": {
      "type": "string", "minLength": 1, "maxLength": 200,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "provenance": { "$ref": "#/$defs/provenance" },
    "evidenceManifest": { "$ref": "#/$defs/evidenceManifestReference" },
    "inlinePayload": { "$ref": "#/$defs/inlinePayload" },
    "artifactRef": { "$ref": "#/$defs/artifactReference" }
  },
  "oneOf": [
    { "required": ["inlinePayload"], "not": { "required": ["artifactRef"] } },
    { "required": ["artifactRef"], "not": { "required": ["inlinePayload"] } }
  ],
  "$defs": {
    "domainIdentifier": {
      "type": "string", "minLength": 1, "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "producer": {
      "type": "object", "additionalProperties": false,
      "required": ["service", "instanceId"],
      "properties": {
        "service": { "const": "DPOMAgent" },
        "instanceId": { "$ref": "#/$defs/domainIdentifier" }
      }
    },
    "sourceAuthority": {
      "type": "object", "additionalProperties": false,
      "required": ["service", "authorityEpoch", "aggregateVersion", "publicationIntentId"],
      "properties": {
        "service": { "const": "DPOMAgent" },
        "authorityEpoch": { "$ref": "#/$defs/domainIdentifier" },
        "aggregateVersion": { "type": "integer", "minimum": 1 },
        "publicationIntentId": { "$ref": "#/$defs/domainIdentifier" }
      }
    },
    "availableVersion": {
      "type": "object", "additionalProperties": false,
      "required": ["status", "name", "version"],
      "properties": {
        "status": { "const": "available" },
        "name": { "type": "string", "minLength": 1, "maxLength": 128 },
        "version": { "type": "string", "minLength": 1, "maxLength": 128 },
        "provider": { "type": "string", "minLength": 1, "maxLength": 128 }
      }
    },
    "unavailableVersion": {
      "type": "object", "additionalProperties": false,
      "required": ["status", "reasonCode"],
      "properties": {
        "status": { "const": "unavailable" },
        "reasonCode": {
          "type": "string",
          "enum": ["NOT_APPLICABLE", "NOT_RECORDED", "LEGACY_SOURCE", "PROVIDER_UNAVAILABLE"]
        }
      }
    },
    "versionDimension": {
      "oneOf": [
        { "$ref": "#/$defs/availableVersion" },
        { "$ref": "#/$defs/unavailableVersion" }
      ]
    },
    "sourceVersion": {
      "oneOf": [
        {
          "type": "object", "additionalProperties": false,
          "required": ["status", "serviceCode"],
          "properties": {
            "status": { "const": "available" },
            "serviceCode": { "$ref": "#/$defs/domainIdentifier" },
            "release": { "type": "string", "minLength": 1, "maxLength": 128 },
            "commitSha": { "type": "string", "pattern": "^[0-9a-fA-F]{7,64}$" }
          },
          "anyOf": [{ "required": ["release"] }, { "required": ["commitSha"] }]
        },
        { "$ref": "#/$defs/unavailableVersion" }
      ]
    },
    "provenance": {
      "type": "object", "additionalProperties": false,
      "required": ["application", "model", "prompt", "skills", "toolContracts", "source", "evidenceSchema"],
      "properties": {
        "application": { "$ref": "#/$defs/versionDimension" },
        "model": { "$ref": "#/$defs/versionDimension" },
        "prompt": { "$ref": "#/$defs/versionDimension" },
        "skills": {
          "type": "array", "minItems": 1, "maxItems": 64,
          "items": { "$ref": "#/$defs/versionDimension" }
        },
        "toolContracts": {
          "type": "array", "minItems": 1, "maxItems": 128,
          "items": { "$ref": "#/$defs/versionDimension" }
        },
        "source": { "$ref": "#/$defs/sourceVersion" },
        "evidenceSchema": { "$ref": "#/$defs/versionDimension" }
      }
    },
    "evidenceManifestReference": {
      "type": "object", "additionalProperties": false,
      "required": ["manifestId", "schemaVersion", "sha256", "byteSize", "sensitivity", "retentionClass"],
      "properties": {
        "manifestId": { "$ref": "#/$defs/domainIdentifier" },
        "schemaVersion": { "type": "string", "pattern": "^1\\.[0-9]+$" },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "byteSize": { "type": "integer", "minimum": 1, "maximum": 1048576 },
        "sensitivity": { "type": "string", "enum": ["INTERNAL", "RESTRICTED"] },
        "retentionClass": { "type": "string", "enum": ["TRANSIENT_7D", "EVAL_90D", "GOLD_LONG_TERM"] }
      }
    },
    "inlinePayload": {
      "type": "object", "additionalProperties": false,
      "required": ["payloadType", "payloadSchemaVersion", "content"],
      "properties": {
        "payloadType": { "type": "string", "enum": ["diagnosis-summary", "replay-manifest"] },
        "payloadSchemaVersion": { "type": "string", "pattern": "^1\\.[0-9]+$" },
        "content": { "type": "object", "minProperties": 1, "maxProperties": 64 }
      }
    },
    "artifactReference": {
      "type": "object", "additionalProperties": false,
      "required": ["artifactId", "locationType", "locator", "mediaType", "byteSize", "sha256", "artifactSchemaVersion", "retentionClass", "createdAt"],
      "properties": {
        "artifactId": { "$ref": "#/$defs/domainIdentifier" },
        "locationType": { "type": "string", "enum": ["controlled-obs-evidence", "evaluation-artifact-store", "local-conformance-fixture"] },
        "locator": {
          "type": "string", "minLength": 1, "maxLength": 512,
          "pattern": "^(?![A-Za-z]:)(?!.*\\.\\.)(?!.*\\\\)[A-Za-z0-9][A-Za-z0-9._:/-]*$"
        },
        "mediaType": { "type": "string", "minLength": 3, "maxLength": 128 },
        "byteSize": { "type": "integer", "minimum": 1, "maximum": 52428800 },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "artifactSchemaVersion": { "type": "string", "pattern": "^1\\.[0-9]+$" },
        "retentionClass": { "type": "string", "enum": ["TRANSIENT_7D", "EVAL_90D", "GOLD_LONG_TERM"] },
        "createdAt": { "type": "string", "format": "date-time" }
      }
    }
  }
}
