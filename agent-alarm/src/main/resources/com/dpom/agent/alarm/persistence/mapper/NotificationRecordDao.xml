<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.dpom.agent.alarm.persistence.NotificationRecordDao">
    <resultMap id="recordResult" type="com.dpom.agent.alarm.domain.NotificationRecord">
        <constructor>
            <idArg column="id" javaType="long"/>
            <arg column="incident_id" javaType="long"/>
            <arg column="rule_id" javaType="long"/>
            <arg column="channel" javaType="com.dpom.agent.alarm.domain.NotificationChannel"/>
            <arg column="recipient" javaType="string"/>
            <arg column="status" javaType="com.dpom.agent.alarm.domain.NotificationStatus"/>
            <arg column="error_message" javaType="string"/>
            <arg column="sent_at" javaType="java.time.LocalDateTime"/>
            <arg column="created_at" javaType="java.time.LocalDateTime"/>
        </constructor>
    </resultMap>

    <insert id="insert" useGeneratedKeys="true" keyProperty="id" keyColumn="id">
        INSERT INTO notification_record (incident_id, rule_id, channel, recipient, status, error_message, sent_at)
        VALUES (#{incidentId}, #{ruleId}, #{channel}, #{recipient}, #{status}, #{errorMessage}, #{sentAt})
    </insert>

    <select id="findByIncidentId" resultMap="recordResult">
        SELECT id, incident_id, rule_id, channel, recipient, status, error_message, sent_at, created_at
        FROM notification_record WHERE incident_id = #{incidentId} ORDER BY id
    </select>
</mapper>
